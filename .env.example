# MongoDB Atlas Configuration
# Use your MongoDB Atlas connection string here
# Format: mongodb://username:password@host1:27017,host2:27017,host3:27017/dbname?options
MONGODB_URI=mongodb://username:password@cluster0-shard-00-00.mongodb.net:27017,cluster0-shard-00-01.mongodb.net:27017,cluster0-shard-00-02.mongodb.net:27017/roomrent?ssl=true&replicaSet=atlas-xxxxx&authSource=admin&retryWrites=true&w=majority

# Database name (default: roomrent)
MONGODB_DB=roomrent

# JWT Secret for token signing
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here_generate_strong_random_value

# Server Port (default: 8081)
# Cloud platforms (Render, Railway) override this with PORT env var
SERVER_PORT=8081

# Logging Level (default: INFO)
# Options: TRACE, DEBUG, INFO, WARN, ERROR
LOGGER_LEVEL=INFO

# Application Environment
# Options: dev, staging, production
APP_ENV=dev

# Optional: CORS allowed origins (if not using default)
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4400

# Optional: Upload directory path
# UPLOAD_DIR=./uploads
